		<script name="SQL_Editor" id="Editor_1b3cd3a" language="SQL" >
			<string><![CDATA[CREATE TABLE entity ( 
	entityUUID           text NOT NULL  PRIMARY KEY  ,
	description          text NOT NULL    ,
	CONSTRAINT unq_description UNIQUE ( description ) 
 ) ;
]]></string>
		</script>
		<script name="SQL_Editor_001" id="Editor_133998e" language="SQL" >
			<string><![CDATA[delete from entityInstance;
select * from attributeInstance;]]></string>
		</script>
		<script name="SQL_Editor_002" id="Editor_4ee6c6a" language="SQL" >
			<string><![CDATA[DROP TABLE IF EXISTS entity;
DROP TABLE IF EXISTS attribute;
DROP TABLE IF EXISTS attributeInstance;
DROP TABLE IF EXISTS entityInstance;
DROP TABLE IF EXISTS entityRelation;]]></string>
		</script>
		<script name="Toas las instancias de Entidades y Atributes" id="Editor_40f4571" language="SQL" >
			<string><![CDATA[
select e.description as entity, a.description as attribute, ei.entityInstanceUUID, ai.attributeInstanceUUID, ai.valueText
from 
	entity e
	join attribute a on (a.entityUUID = e.entityUUID)
	join entityInstance ei on (ei.entityUUID = e.entityUUID)
	join attributeInstance ai on (ai.attributeUUID = a.attributeUUID) and (ai.entityInstanceUUID = ei.entityInstanceUUID)]]></string>
		</script>
		<script name="attribute" id="Editor_4e0b47c" language="SQL" >
			<string><![CDATA[INSERT INTO attribute
	( attributeUUID, description, entityUUID) VALUES ( "kk", "kk", "a2db680a-da2b-4034-a5ab-9b4a4d8ec95c" );]]></string>
		</script>
		<script name="attributeInstance" id="Editor_58bbfdb" language="SQL" >
			<string><![CDATA[INSERT INTO attributeInstance
	( attributeInstanceUUID, valueNum, valueText, valueBlob, attributeUUID, entityInstanceUUID) VALUES ( ?, ?, ?, ?, ?, ? );]]></string>
		</script>
		<script name="attributeInstance_001" id="Editor_436b18b" language="SQL" >
			<string><![CDATA[PRAGMA foreign_keys=on;
CREATE TABLE attributeInstance ( 
	attributeInstanceUUID text NOT NULL  PRIMARY KEY  ,
	valueNum             numeric     ,
	valueText            text     ,
	valueBlob            blob     ,
	attributeUUID        text NOT NULL    ,
	entityInstanceUUID   text NOT NULL    ,
	CONSTRAINT sqlite_autoindex_attributeInstance_2 UNIQUE ( attributeUUID ) ,
	CONSTRAINT sqlite_autoindex_attributeInstance_3 UNIQUE ( entityInstanceUUID ) ,
	FOREIGN KEY ( entityInstanceUUID ) REFERENCES entityInstance( entityInstanceUUID ) ON DELETE CASCADE ,
	FOREIGN KEY ( attributeUUID ) REFERENCES attribute( attributeUUID ) ON DELETE CASCADE 
 );]]></string>
		</script>
		<script name="attributeInstance_002" id="Editor_4ccae2b" language="SQL" >
			<string><![CDATA[PRAGMA foreign_keys=on;

CREATE TABLE attributeInstance ( 
	attributeInstanceUUID text NOT NULL  PRIMARY KEY  ,
	valueNum             numeric     ,
	valueText            text     ,
	valueBlob            blob     ,
	attributeUUID        text NOT NULL    ,
	entityInstanceUUID   text NOT NULL    ,
	FOREIGN KEY ( entityInstanceUUID ) REFERENCES entityInstance( entityInstanceUUID ) ON DELETE CASCADE ,
	FOREIGN KEY ( attributeUUID ) REFERENCES attribute( attributeUUID ) ON DELETE CASCADE 
 );

CREATE INDEX idx_entityInstance_attributeUUID ON attributeInstance ( attributeUUID );

CREATE INDEX idx_entityInstance_entityInstanceUUID ON attributeInstance ( entityInstanceUUID );
]]></string>
		</script>
		<script name="attributeInstance_003" id="Editor_3dfd360" language="SQL" >
			<string><![CDATA[CREATE TABLE attributeInstance ( 
	attributeInstanceUUID text NOT NULL  PRIMARY KEY  ,
	valueNum             numeric     ,
	valueText            text     ,
	valueBlob            blob     ,
	attributeUUID        text NOT NULL    ,
	entityInstanceUUID   text NOT NULL    ,
	FOREIGN KEY ( entityInstanceUUID ) REFERENCES entityInstance( entityInstanceUUID ) ON DELETE CASCADE ,
	FOREIGN KEY ( attributeUUID ) REFERENCES attribute( attributeUUID ) ON DELETE CASCADE 
 );

CREATE INDEX idx_entityInstance_attributeUUID ON attributeInstance ( attributeUUID );

CREATE INDEX idx_entityInstance_entityInstanceUUID ON attributeInstance ( entityInstanceUUID );
]]></string>
		</script>
		<script name="attribute_001" id="Editor_4e5108a" language="SQL" >
			<string><![CDATA[CREATE TABLE attribute ( 
	attributeUUID        text NOT NULL  PRIMARY KEY  ,
	description          text NOT NULL    ,
	entityUUID           text     ,
	FOREIGN KEY ( entityUUID ) REFERENCES entity( entityUUID ) ON DELETE CASCADE 
 );

CREATE INDEX Idx_description ON attribute ( description );

CREATE INDEX idx_entityUUID ON attribute ( entityUUID );
]]></string>
		</script>
		<script name="entity" id="Editor_1688d93" language="SQL" >
			<string><![CDATA[select * from entity;
select * from attribute;

delete from attribute;
delete from entity;]]></string>
		</script>
		<script name="entityInstance" id="Editor_5432da1" language="SQL" >
			<string><![CDATA[PRAGMA foreign_keys=on;
drop table entityInstance;]]></string>
		</script>
		<script name="entityInstance_001" id="Editor_357834c" language="SQL" >
			<string><![CDATA[PRAGMA foreign_keys=on;

CREATE TABLE entityInstance ( 
	entityInstanceUUID   text NOT NULL  PRIMARY KEY  ,
	entityUUID           text NOT NULL    ,
	FOREIGN KEY ( entityUUID ) REFERENCES entity( entityUUID ) ON DELETE CASCADE 
 );

CREATE INDEX idx_entityInstance_entityUUID ON entityInstance ( entityUUID );
]]></string>
		</script>
		<script name="entityRelation_001" id="Editor_478a0f3" language="SQL" >
			<string><![CDATA[PRAGMA foreign_keys=on;
CREATE TABLE entityRelation ( 
	entityRelationUUID   text NOT NULL  PRIMARY KEY  ,
	entityUUID1          text NOT NULL    ,
	entityUUID2          text NOT NULL    ,
	description          text NOT NULL    ,
	CONSTRAINT sqlite_autoindex_entityRelation_2 UNIQUE ( entityUUID1 ) ,
	CONSTRAINT sqlite_autoindex_entityRelation_3 UNIQUE ( entityUUID2 ) ,
	FOREIGN KEY ( entityUUID2, entityUUID1 ) REFERENCES entity( entityUUID, entityUUID ) ON DELETE CASCADE 
 );]]></string>
		</script>
