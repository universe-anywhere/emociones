	<schema name="Default" >
		<table name="attribute" >
			<comment><![CDATA[Definicion de los atributos de una entidad]]></comment>
			<column name="attributeUUID" type="text" jt="-1" mandatory="y" >
				<comment><![CDATA[UUID para identificar la defiinicion de un atributo de una entidad]]></comment>
			</column>
			<column name="description" type="text" jt="-1" mandatory="y" >
				<comment><![CDATA[Descripcion del atributo que se está definiendo para la entidad]]></comment>
			</column>
			<column name="entityUUID" type="text" jt="-1" >
				<comment><![CDATA[Entidad a la que pertenece el atributo que se define]]></comment>
			</column>
			<index name="pk_attribute" unique="PRIMARY_KEY" >
				<column name="attributeUUID" />
			</index>
			<index name="Idx_description" unique="NORMAL" >
				<column name="description" />
			</index>
			<index name="idx_entityUUID" unique="NORMAL" >
				<column name="entityUUID" />
			</index>
			<fk name="Fk_attribute" to_schema="Default" to_table="entity" delete_action="cascade" >
				<fk_column name="entityUUID" pk="entityUUID" />
			</fk>
		</table>
		<table name="attributeInstance" >
			<comment><![CDATA[Instancia de un atributo para definir su valor]]></comment>
