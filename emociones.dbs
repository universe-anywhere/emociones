			<column name="valueText" type="text" length="250" jt="-1" >
				<comment><![CDATA[Valor de texto del atributo (so lo tiene)]]></comment>
			</column>
			<column name="valueBlob" type="blob" jt="2004" >
				<comment><![CDATA[Valor de Blob del atributo (si lo tiene)]]></comment>
			</column>
			<column name="attributeUUID" type="text" jt="-1" mandatory="y" >
				<comment><![CDATA[Identificador de la definicion del atributo]]></comment>
			</column>
			<column name="entityInstanceUUID" type="text" jt="-1" mandatory="y" >
				<comment><![CDATA[Identificador de la instancia de la entidad a la que pertenece la instancia del atributo]]></comment>
			</column>
			<index name="pk_attributeInstance" unique="PRIMARY_KEY" >
				<column name="attributeInstanceUUID" />
			</index>
			<index name="idx_entityInstance_attributeUUID" unique="NORMAL" >
