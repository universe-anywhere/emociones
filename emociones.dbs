		<script name="entityRelation_001" id="Editor_478a0f3" language="SQL" >
			<string><![CDATA[PRAGMA foreign_keys=on;
CREATE TABLE entityRelation ( 
	entityRelationUUID   text NOT NULL  PRIMARY KEY  ,
