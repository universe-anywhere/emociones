		<script name="SQL_Editor" id="Editor_1b3cd3a" language="SQL" >
			<string><![CDATA[CREATE TABLE entity ( 
	entityUUID           text NOT NULL  PRIMARY KEY  ,
	description          text NOT NULL    ,
	CONSTRAINT unq_description UNIQUE ( description ) 
 ) ;
]]></string>
		</script>
		<script name="SQL_Editor_001" id="Editor_133998e" language="SQL" >
			<string><![CDATA[drop table entityRelation]]></string>
		</script>
		<script name="SQL_Editor_002" id="Editor_4ee6c6a" language="SQL" >
			<string><![CDATA[DROP TABLE IF EXISTS entity;
DROP TABLE IF EXISTS attribute;
DROP TABLE IF EXISTS attributeInstance;
DROP TABLE IF EXISTS entityInstance;
DROP TABLE IF EXISTS entityRelation;]]></string>
		</script>
		<script name="SQL_Editor_003" id="Editor_1f4e825" language="SQL" >
			<string><![CDATA[
select e.description as entity, e.entityUUID, a.description as attribute, ei.entityInstanceUUID, ai.attributeInstanceUUID, ai.valueBlob, ai.valueText
from 
	entity e
	left join attribute a on (a.entityUUID = e.entityUUID)
	left join entityInstance ei on (ei.entityUUID = e.entityUUID)
	left join attributeInstance ai on (ai.attributeUUID = a.attributeUUID) and (ai.entityInstanceUUID = ei.entityInstanceUUID)
where
   e.description = "imagen";

delete from entityInstance where entityUUID = "5625c5ef-ad67-4368-aee5-79c090292f2d";
update attribute set description = 'jpg' where description = 'blog';]]></string>
		</script>
		<script name="SQL_Editor_004" id="Editor_51e520c" language="SQL" >
			<string><![CDATA[drop table entitiesRelationshipInstance;]]></string>
		</script>
		<script name="SQL_Editor_005" id="Editor_434e859" language="SQL" >
			<string><![CDATA[CREATE TABLE relationship ( 
	relationshipUUID     text NOT NULL  PRIMARY KEY  ,
	description          text NOT NULL    ,
	CONSTRAINT Idx_relationship UNIQUE ( description ) 
 ) ;
]]></string>
		</script>
		<script name="SQL_Editor_006" id="Editor_14ce04b" language="SQL" >
			<string><![CDATA[SELECT 
    lower(hex(randomblob(4))) || '-' || 
    lower(hex(randomblob(2))) || '-' || 
    '4' || substr(lower(hex(randomblob(2))), 2) || '-' || 
    substr('89ab', abs(random()) % 4 + 1, 1) || substr(lower(hex(randomblob(2))), 2) || '-' || 
    lower(hex(randomblob(6))) AS uuid;]]></string>
		</script>
		<script name="SQL_Editor_007" id="Editor_5d25b0" language="SQL" >
			<string><![CDATA[select count(1)
from (
select e.description as entity, e.entityUUID, a.description as attribute, ei.entityInstanceUUID, ai.attributeInstanceUUID, ai.valueBlob, ai.valueText
from 
	entity e
	left join attribute a on (a.entityUUID = e.entityUUID)
	left join entityInstance ei on (ei.entityUUID = e.entityUUID)
	left join attributeInstance ai on (ai.attributeUUID = a.attributeUUID) and (ai.entityInstanceUUID = ei.entityInstanceUUID)
where
   e.description = "imagen"
);

select count(1)
from entitiesRelationshipInstance;]]></string>
		</script>
