		<script name="attributeInstance_001" id="Editor_436b18b" language="SQL" >
			<string><![CDATA[PRAGMA foreign_keys=on;
CREATE TABLE attributeInstance ( 
	attributeInstanceUUID text NOT NULL  PRIMARY KEY  ,
	valueNum             numeric     ,
	valueText            text     ,
	valueBlob            blob     ,
	attributeUUID        text NOT NULL    ,
	entityInstanceUUID   text NOT NULL    ,
	CONSTRAINT sqlite_autoindex_attributeInstance_2 UNIQUE ( attributeUUID ) ,
	CONSTRAINT sqlite_autoindex_attributeInstance_3 UNIQUE ( entityInstanceUUID ) ,
	FOREIGN KEY ( entityInstanceUUID ) REFERENCES entityInstance( entityInstanceUUID ) ON DELETE CASCADE ,
	FOREIGN KEY ( attributeUUID ) REFERENCES attribute( attributeUUID ) ON DELETE CASCADE 
 );]]></string>
		</script>
		<script name="attributeInstance_002" id="Editor_4ccae2b" language="SQL" >
			<string><![CDATA[PRAGMA foreign_keys=on;

CREATE TABLE attributeInstance ( 
	attributeInstanceUUID text NOT NULL  PRIMARY KEY  ,
	valueNum             numeric     ,
	valueText            text     ,
	valueBlob            blob     ,
	attributeUUID        text NOT NULL    ,
	entityInstanceUUID   text NOT NULL    ,
	FOREIGN KEY ( entityInstanceUUID ) REFERENCES entityInstance( entityInstanceUUID ) ON DELETE CASCADE ,
	FOREIGN KEY ( attributeUUID ) REFERENCES attribute( attributeUUID ) ON DELETE CASCADE 
 );

CREATE INDEX idx_entityInstance_attributeUUID ON attributeInstance ( attributeUUID );

CREATE INDEX idx_entityInstance_entityInstanceUUID ON attributeInstance ( entityInstanceUUID );
]]></string>
		</script>
		<script name="attributeInstance_003" id="Editor_3dfd360" language="SQL" >
			<string><![CDATA[CREATE TABLE attributeInstance ( 
	attributeInstanceUUID text NOT NULL  PRIMARY KEY  ,
	valueNum             numeric     ,
	valueText            text     ,
	valueBlob            blob     ,
	attributeUUID        text NOT NULL    ,
	entityInstanceUUID   text NOT NULL    ,
	FOREIGN KEY ( entityInstanceUUID ) REFERENCES entityInstance( entityInstanceUUID ) ON DELETE CASCADE ,
	FOREIGN KEY ( attributeUUID ) REFERENCES attribute( attributeUUID ) ON DELETE CASCADE 
 );

CREATE INDEX idx_entityInstance_attributeUUID ON attributeInstance ( attributeUUID );

CREATE INDEX idx_entityInstance_entityInstanceUUID ON attributeInstance ( entityInstanceUUID );]]></string>
		</script>
		<script name="attribute_001" id="Editor_4e5108a" language="SQL" >
			<string><![CDATA[CREATE TABLE attribute ( 
	attributeUUID        text NOT NULL  PRIMARY KEY  ,
	description          text NOT NULL    ,
	entityUUID           text     ,
	FOREIGN KEY ( entityUUID ) REFERENCES entity( entityUUID ) ON DELETE CASCADE 
 );

CREATE INDEX Idx_description ON attribute ( description );

CREATE INDEX idx_entityUUID ON attribute ( entityUUID );]]></string>
		</script>
